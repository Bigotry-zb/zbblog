---
import Icon from './Icon.astro';

interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
const url = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="分页">
      {current > 1 && (
        <a class="page-number" href={url(current - 1)} aria-label="上一页">
          <Icon name="arrowLeft" />
        </a>
      )}

      {pages.map((n) =>
        n === current ? (
          <span class="page-number current" aria-current="page">
            {n}
          </span>
        ) : (
          <a class="page-number" href={url(n)}>
            {n}
          </a>
        )
      )}

      {current < total && (
        <a class="page-number" href={url(current + 1)} aria-label="下一页">
          <Icon name="arrowRight" />
        </a>
      )}
    </nav>
  )
}
