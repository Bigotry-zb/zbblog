---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, tagHref, categoryHref } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, categories, tags, pinned } = post.data;
const url = `/blog/${post.id}/`;
---

<article class="index-card">
  <h1 class="index-header">
    {pinned && <span class="pinned-flag">[置顶]</span>}
    <a href={url}>{title}</a>
  </h1>

  {description && <a class="index-excerpt" href={url}>{description}</a>}

  <div class="post-metas">
    <div class="post-meta">
      <Icon name="calendar" />
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>

    {
      categories.length > 0 && (
        <div class="post-meta">
          <Icon name="category" />
          {categories.map((category) => (
            <a class="category-chain" href={categoryHref(category)}>
              {category}
            </a>
          ))}
        </div>
      )
    }

    {
      tags.length > 0 && (
        <div class="post-meta">
          <Icon name="tags" />
          {tags.map((tag) => (
            <a class="tag" href={tagHref(tag)}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
