---
import { SITE, SOCIALS } from '../consts';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const range = SITE.since === year ? `${year}` : `${SITE.since} - ${year}`;
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-links">
      {
        SOCIALS.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            <Icon name={social.icon} /> {social.label}
          </a>
        ))
      }
    </div>

    <div>Copyright © {range} {SITE.title}</div>

    {
      SITE.icp && (
        <div>
          <a href="https://beian.miit.gov.cn/" rel="noopener" target="_blank">
            {SITE.icp}
          </a>
        </div>
      )
    }
    {
      SITE.police && (
        <div>
          <a href="https://beian.mps.gov.cn/" rel="noopener" target="_blank">
            {SITE.police}
          </a>
        </div>
      )
    }
  </div>
</footer>

<script
  defer
  is:inline
  src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"
/>
