---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE, POSTS_PER_PAGE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const total = Math.ceil(posts.length / POSTS_PER_PAGE);
const current = posts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout description={SITE.description}>
  <Fragment slot="hero">
    <Hero height="full" subtitle={SITE.subtitle} typing />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      <PostList posts={current} />
      <Pagination current={1} total={total} />
    </div>
    <Sidebar posts={posts} />
  </div>
</BaseLayout>
