---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="404" description="页面不存在">
  <Fragment slot="hero">
    <Hero height="short" title="404" subtitle="你要找的页面不存在" />
  </Fragment>

  <div class="post-grid no-toc">
    <article class="article-content-card" style="text-align:center">
      <p class="page-desc">页面可能已被移动或删除。</p>
      <p><a href="/">← 回到首页</a></p>
    </article>
  </div>
</BaseLayout>
