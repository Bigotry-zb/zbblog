---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../consts';
import {
  formatDate,
  readingTime,
  tagHref,
  categoryHref,
} from '../../utils/format';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, categories, tags, cover } =
  post.data;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const minutes = readingTime(post.body);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
>
  <Fragment slot="hero">
    <Hero height="short" title={title} image={cover || SITE.hero}>
      <div class="hero-meta">
        <span><Icon name="calendar" /> {formatDate(pubDate)}</span>
        <span><Icon name="clock" /> 约 {minutes} 分钟阅读</span>
      </div>
    </Hero>
  </Fragment>

  <div class:list={['post-grid', { 'no-toc': toc.length <= 1 }]}>
    <article class="article-content-card">
      <header class="post-header">
        <div class="post-metas">
          {
            categories.length > 0 && (
              <div class="post-meta">
                <Icon name="category" />
                {categories.map((category) => (
                  <a href={categoryHref(category)}>{category}</a>
                ))}
              </div>
            )
          }
          {
            tags.length > 0 && (
              <div class="post-meta">
                <Icon name="tags" />
                {tags.map((tag) => (
                  <a href={tagHref(tag)}>#{tag}</a>
                ))}
              </div>
            )
          }
          {
            updatedDate && (
              <div class="post-meta">
                <Icon name="clock" />
                更新于 {formatDate(updatedDate)}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <div class="post-footer">
        <a href="/archives/"><Icon name="arrowLeft" /> 返回归档</a>
        <a href="/">回到首页 <Icon name="arrowRight" /></a>
      </div>
    </article>

    {
      toc.length > 1 && (
        <aside class="post-toc">
          <div class="toc-title">目录</div>
          <ul>
            {toc.map((h) => (
              <li style={h.depth >= 3 ? 'margin-left:12px' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <div class="post-comments-wrap">
    <Comments />
  </div>
</BaseLayout>
