---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import Sidebar from '../../components/Sidebar.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        allPosts: posts,
        current: page,
        total,
      },
    };
  });
}

const { posts, allPosts, current, total } = Astro.props;
---

<BaseLayout title={`第 ${current} 页`} description="文章列表">
  <Fragment slot="hero">
    <Hero height="short" title="文章" subtitle={`第 ${current} 页`} />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      <PostList posts={posts} />
      <Pagination current={current} total={total} />
    </div>
    <Sidebar posts={allPosts} />
  </div>
</BaseLayout>
