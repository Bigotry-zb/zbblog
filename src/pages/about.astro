---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIALS } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="关于" description="关于我">
  <Fragment slot="hero">
    <Hero height="short" title="关于" subtitle={SITE.subtitle} />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      <article class="article-content-card">
        <div class="about-header">
          <img class="profile-avatar" src={SITE.avatar} alt={SITE.author} />
          <div>
            <h1 class="page-title" style="margin:0">{SITE.author}</h1>
            <p class="page-desc" style="margin:6px 0 0">{SITE.bio}</p>
          </div>
        </div>

        <div class="prose">
          <p>
            你好，我是 Zbiao，一名后端开发者。这里记录我的技术笔记、项目复盘和一些想法。
          </p>
          <p>
            本站是一个纯静态博客：文章用 Markdown 编写，存放在 Git 仓库中，构建后由
            Nginx 托管，部署在阿里云 ECS 上。
          </p>

          <h2>联系我</h2>
          <ul>
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target={social.href.startsWith('http') ? '_blank' : undefined}
                    rel="noopener"
                  >
                    <Icon name={social.icon} /> {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
    <Sidebar posts={posts} />
  </div>
</BaseLayout>
