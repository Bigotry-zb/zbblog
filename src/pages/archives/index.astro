---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';
import { formatMonthDay } from '../../utils/format';
import { getPublishedPosts, groupByYear } from '../../utils/posts';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<BaseLayout title="归档" description="按年份归档的文章">
  <Fragment slot="hero">
    <Hero height="short" title="归档" subtitle={`共 ${posts.length} 篇文章`} />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      {
        years.length === 0 ? (
          <p class="empty">还没有文章。</p>
        ) : (
          years.map(([year, list]) => (
            <section class="archive-year">
              <h2>{year}</h2>
              <ul class="archive-list">
                {list.map((post) => (
                  <li>
                    <span class="archive-date">
                      {formatMonthDay(post.data.pubDate)}
                    </span>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )
      }
    </div>
    <Sidebar posts={posts} />
  </div>
</BaseLayout>
