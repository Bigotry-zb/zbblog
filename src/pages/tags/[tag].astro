---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import Sidebar from '../../components/Sidebar.astro';
import { slugifyTag } from '../../utils/format';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!byTag.has(slug)) byTag.set(slug, { name: tag, posts: [] });
      byTag.get(slug)!.posts.push(post);
    }
  }

  return [...byTag.entries()].map(([slug, value]) => ({
    params: { tag: slug },
    props: { tagName: value.name, posts: value.posts, allPosts: posts },
  }));
}

const { tagName, posts, allPosts } = Astro.props;
---

<BaseLayout title={`标签：${tagName}`} description={`标签 ${tagName} 下的文章`}>
  <Fragment slot="hero">
    <Hero height="short" title={`#${tagName}`} subtitle={`共 ${posts.length} 篇`} />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      <PostList posts={posts} />
    </div>
    <Sidebar posts={allPosts} />
  </div>
</BaseLayout>
