---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugifyTag } from '../../utils/format';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!byTag.has(slug)) byTag.set(slug, { name: tag, posts: [] });
      byTag.get(slug)!.posts.push(post);
    }
  }

  return [...byTag.entries()].map(([slug, value]) => ({
    params: { tag: slug },
    props: { tagName: value.name, posts: value.posts },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={`标签：${tagName}`} description={`标签 ${tagName} 下的文章`}>
  <h1 class="page-title">标签：{tagName}</h1>
  <p class="page-desc">共 {posts.length} 篇</p>

  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>

  <p style="margin-top:24px;"><a href="/tags/">← 全部标签</a></p>
</BaseLayout>
