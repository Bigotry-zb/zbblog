---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagHref } from '../../utils/format';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <h1 class="page-title">标签</h1>
  <p class="page-desc">共 {tags.length} 个标签</p>

  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。</p>
    ) : (
      <div class="tag-cloud">
        {tags.map((tag) => (
          <a class="tag" href={tagHref(tag.name)}>
            {tag.name} ({tag.count})
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
