---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';
import { tagHref } from '../../utils/format';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <Fragment slot="hero">
    <Hero height="short" title="标签" subtitle={`共 ${tags.length} 个标签`} />
  </Fragment>

  <div class="layout">
    <div class="main-col">
      {
        tags.length === 0 ? (
          <p class="empty">还没有标签。</p>
        ) : (
          <div class="chip-list">
            {tags.map((tag) => (
              <a class="chip" href={tagHref(tag.name)}>
                #{tag.name}
                <span class="chip-count">{tag.count}</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
    <Sidebar posts={posts} />
  </div>
</BaseLayout>
