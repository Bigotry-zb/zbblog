---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { categoryHref } from '../../utils/format';
import { getAllCategories, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const categories = getAllCategories(posts);
---

<BaseLayout title="分类" description="按分类浏览文章">
  <Fragment slot="hero">
    <Hero height="short" title="分类" subtitle={`共 ${categories.length} 个分类`} />
  </Fragment>

  {
    categories.length === 0 ? (
      <p class="empty">还没有分类。</p>
    ) : (
      <div class="chip-list">
        {categories.map((category) => (
          <a class="chip" href={categoryHref(category.name)}>
            {category.name}
            <span class="chip-count">{category.count}</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
