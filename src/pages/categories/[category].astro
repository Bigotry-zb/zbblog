---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import { slugifyCategory } from '../../utils/format';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byCategory = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const category of post.data.categories) {
      const slug = slugifyCategory(category);
      if (!byCategory.has(slug)) byCategory.set(slug, { name: category, posts: [] });
      byCategory.get(slug)!.posts.push(post);
    }
  }

  return [...byCategory.entries()].map(([slug, value]) => ({
    params: { category: slug },
    props: { categoryName: value.name, posts: value.posts },
  }));
}

const { categoryName, posts } = Astro.props;
---

<BaseLayout title={`分类：${categoryName}`} description={`分类 ${categoryName} 下的文章`}>
  <Fragment slot="hero">
    <Hero
      height="short"
      title={`分类：${categoryName}`}
      subtitle={`共 ${posts.length} 篇`}
    />
  </Fragment>

  <PostList posts={posts} />
</BaseLayout>
